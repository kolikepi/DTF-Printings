# ── Databaza (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://elev8:elev8@localhost:5432/elev8_printings"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Gjenero me: openssl rand -base64 32
NEXTAUTH_SECRET="ndrysho-me-nje-sekret-te-rastesishem"
NEXTAUTH_URL="http://localhost:3000"

# ── Admin fillestar (opsional, përdoret nga `npm run seed`) ─────────────────
# Nëse i lë bosh, seed-i gjeneron një fjalëkalim të rastësishëm dhe e shtyp një herë.
# ADMIN_EMAIL="admin@elev8printings.al"
# ADMIN_PASSWORD=""

# ── Storage për dizajnet e ngarkuara ────────────────────────────────────────
# "local" = disku i serverit (asnjë llogari cloud e nevojshme)
# "s3"    = çdo storage S3-compatible: AWS S3, Cloudflare R2, MinIO, Backblaze B2
STORAGE_DRIVER="local"

# Vetëm për STORAGE_DRIVER=local
UPLOAD_DIR="./storage"

# Kufiri i madhësisë së skedarit (bytes) — default 25 MB
# MAX_UPLOAD_BYTES=26214400

# Vetëm për STORAGE_DRIVER=s3
# AWS_S3_BUCKET="emri-i-bucket"
# AWS_REGION="eu-central-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""            # p.sh. https://<account>.r2.cloudflarestorage.com për R2
# S3_FORCE_PATH_STYLE="false"  # "true" për MinIO

# ── Build ───────────────────────────────────────────────────────────────────
# NEXT_OUTPUT_MODE="standalone"   # vendoset automatikisht në Docker

# ── Email (njoftimet për oferta, mesazhe dhe porosi) ────────────────────────
# Zgjidh njërën rrugë. Pa asnjërën, faqja punon por email-et vetëm shkruhen te log-u.
# 1) Resend — 3.000 email/muaj falas: https://resend.com
# RESEND_API_KEY=""
# 2) Ose SMTP (Gmail, Zoho, hosting-u yt)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# Dërguesi dhe adresa ku vijnë njoftimet e biznesit
# EMAIL_FROM="Elev8 Printings <porosi@domeni-yt.al>"
# ADMIN_NOTIFY_EMAIL="ti@domeni-yt.al"

# ── Çmimet (opsionale — ndryshojnë kudo njëherësh) ─────────────────────────
# NEXT_PUBLIC_SHIPPING_COST="300"
# NEXT_PUBLIC_FREE_SHIPPING_OVER="5000"

# ── Të dhënat e biznesit (dalin te faqja, footer-i dhe SEO) ────────────────
# NEXT_PUBLIC_PHONE="+355 69 205 5861"
# NEXT_PUBLIC_EMAIL="info@domeni-yt.al"
# NEXT_PUBLIC_WHATSAPP="355692055861"
# NEXT_PUBLIC_ADDRESS="Rruga …, Tiranë"
# NEXT_PUBLIC_LEGAL_NAME="Emri i regjistruar Sh.p.k."
# NEXT_PUBLIC_NIPT=""
# NEXT_PUBLIC_OPENING_HOURS="Mo-Sa 09:00-18:00"

# ── Analitika (opsionale) ──────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="domeni-yt.al"
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
